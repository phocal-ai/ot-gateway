{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "vitest", "node"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "options": {
    "typeAware": true
  },
  "ignorePatterns": ["repos/**", "observability/grafana/dashboards/**"],
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/consistent-type-imports": "error",
    "eslint/no-console": "error",
    "typescript/consistent-return": "off",
    "typescript/switch-exhaustiveness-check": "error",
    "eslint/no-underscore-dangle": [
      "error",
      {
        "allow": ["_tag"]
      }
    ],
    "vitest/no-standalone-expect": [
      "error",
      {
        "additionalTestBlockFunctions": [
          "it.effect",
          "it.live",
          "it.scoped",
          "it.scopedLive",
          "it.layer",
          "it.prop",
          "it.effect.prop"
        ]
      }
    ],
    "oxc/no-map-spread": "off",
    "eslint/no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@effect/platform-node",
            "message": "Import the module you need, e.g. @effect/platform-node/NodeSocket: the barrel loads every Node module (HTTP, workers, cluster) and costs the gateway about 30 MB of memory."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/test/**", "apps/**", "scripts/**", "observability/**"],
      "rules": {
        "eslint/no-console": "off"
      }
    }
  ]
}
