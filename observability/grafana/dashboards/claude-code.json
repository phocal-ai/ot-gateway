    {
      "id": 8,
      "type": "timeseries",
      "title": "Cost by repository",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "sum by (vcs_repository_name) (sum_over_time({service_name=\"claude-code\", service_namespace=\"phocal\"} | vcs_repository_name=~\"$repository\" | event_name=\"api_request\" | model=~\"$model\" | unwrap cost_usd [$__auto]))",
          "legendFormat": "{{vcs_repository_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
