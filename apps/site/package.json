{
  "name": "@ot-gateway/site",
  "version": "0.0.0",
  "private": true,
  "description": "The project and docs site: a Next.js static export built with Fumadocs, hosted on Vercel.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "content": "node scripts/content.ts && fumadocs-mdx",
    "dev": "pnpm content && next dev --port 3001",
    "build": "pnpm content && next build",
    "typecheck": "pnpm content && tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "fumadocs-core": "16.17.10",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "16.17.10",
    "lucide-react": "^1.69.0",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/mdx": "^2.0.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "4.3.4"
  },
  "engines": {
    "node": "24.x"
  }
}
