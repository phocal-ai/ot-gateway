{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "typecheck": {
      "inputs": [
        "src/**",
        "test/**",
        "scripts/**",
        "source.config.ts",
        "next.config.ts",
        "tsconfig.json",
        "../../tsconfig.base.json",
        "../../docs/*.md",
        "../../README.md"
      ]
    },
    "test": {
      "inputs": ["src/**", "test/**", "../../docs/*.md", "../../README.md"]
    },
    "build": {
      "description": "Not cached: the pages come from docs/*.md, the README and whatever else scripts/content.ts lists, so a cached build could deploy stale docs",
      "cache": false
    }
  }
}
