{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "ignoreCommand": "bash scripts/ignore-build.sh",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "dev": true,
      "site/**": true,
      "**": false
    }
  },
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index"
    },
    {
      "source": "/docs.md",
      "destination": "/llms.mdx/docs/content.md"
    },
    {
      "source": "/docs/:slug*.md",
      "destination": "/llms.mdx/docs/:slug*/content.md"
    }
  ]
}
