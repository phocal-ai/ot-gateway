{
  "name": "@plenum/gateway",
  "version": "0.0.0",
  "private": true,
  "description": "Ready-to-run Plenum gateway.",
  "license": "MIT",
  "bin": {
    "plenum": "./src/main.ts"
  },
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=${PLENUM_ENV_FILE:-$HOME/.config/phocal/plenum-gateway.env} src/main.ts ../../examples/gateway.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.2",
    "@plenum/core": "workspace:*",
    "@plenum/simulator": "workspace:*",
    "effect": "4.1.2"
  }
}
