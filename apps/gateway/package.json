{
  "name": "@ot-gateway/gateway",
  "version": "0.0.0",
  "private": true,
  "description": "Ready-to-run OT Gateway.",
  "license": "MIT",
  "bin": {
    "ot-gateway": "./src/main.ts"
  },
  "type": "module",
  "scripts": {
    "start": "node --max-semi-space-size=4 --env-file-if-exists=${OT_GATEWAY_ENV_FILE:-$HOME/.config/phocal/ot-gateway.env} src/main.ts ../../examples/gateway.json",
    "bench": "node src/bench.ts ../../examples/gateway.json",
    "sim": "vitest run test/Simulation.test.ts --silent=false",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.2",
    "@ot-gateway/api": "workspace:*",
    "@ot-gateway/bacnet": "workspace:*",
    "@ot-gateway/buffer": "workspace:*",
    "@ot-gateway/core": "workspace:*",
    "@ot-gateway/history": "workspace:*",
    "@ot-gateway/modbus": "workspace:*",
    "@ot-gateway/mqtt": "workspace:*",
    "@ot-gateway/simulator": "workspace:*",
    "effect": "4.1.2"
  }
}
