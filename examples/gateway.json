{
  "site": "demo-site",
  "building": "building-a",
  "id": "main",
  "mqtt": {
    "url": "mqtt://localhost:1883",
    "clientId": "ot-gateway-demo"
  },
  "buffer": {
    "path": "./ot-gateway-buffer.sqlite"
  },
  "history": {
    "path": "./ot-gateway-history.sqlite"
  },
  "status": {},
  "devices": [
    {
      "protocol": "simulator",
      "id": "ventilation-1",
      "pollIntervalMs": 2000,
      "points": [
        {
          "id": "supply-air-temp",
          "name": "Ventilation 1 supply air temperature",
          "unit": "unit:DEG_C",
          "deadband": 0.2,
          "waveform": "sine",
          "min": 16,
          "max": 22,
          "periodSeconds": 60,
          "semantics": {
            "brick": "Supply_Air_Temperature_Sensor",
            "haystack": ["discharge", "air", "temp", "sensor"]
          }
        },
        {
          "id": "fan-speed",
          "name": "Ventilation 1 supply fan speed",
          "unit": "unit:PERCENT",
          "waveform": "ramp",
          "min": 0,
          "max": 100,
          "periodSeconds": 30,
          "semantics": {
            "brick": "Supply_Fan_Speed_Command",
            "haystack": ["discharge", "fan", "speed", "cmd"]
          }
        }
      ]
    },
    {
      "protocol": "modbus-tcp",
      "id": "energy-meter",
      "host": "127.0.0.1",
      "unitId": 1,
      "points": [
        {
          "id": "active-power",
          "name": "Energy meter active power",
          "unit": "unit:KiloW",
          "table": "holding",
          "address": 100,
          "dataType": "float32",
          "semantics": {
            "brick": "Active_Power_Sensor",
            "haystack": ["elec", "power", "active", "sensor"]
          }
        },
        {
          "id": "energy",
          "name": "Energy meter energy counter",
          "unit": "unit:KiloW-HR",
          "table": "input",
          "address": 0,
          "dataType": "uint32",
          "semantics": {
            "brick": "Energy_Sensor",
            "haystack": ["elec", "energy", "sensor"]
          }
        },
        {
          "id": "breaker-tripped",
          "name": "Main breaker tripped",
          "table": "discrete",
          "address": 0,
          "dataType": "bool",
          "semantics": {
            "brick": "Alarm",
            "haystack": ["elec", "breaker", "alarm"]
          }
        }
      ],
      "port": 5020
    },
    {
      "protocol": "bacnet-ip",
      "id": "ventilation-2",
      "deviceInstance": 2001,
      "address": "127.0.0.1:47809",
      "pollIntervalMs": 5000,
      "points": [
        {
          "id": "supply-air-temp",
          "name": "Ventilation 2 supply air temperature",
          "unit": "unit:DEG_C",
          "deadband": 0.2,
          "objectType": "analog-input",
          "instance": 1,
          "semantics": {
            "brick": "Supply_Air_Temperature_Sensor",
            "haystack": ["discharge", "air", "temp", "sensor"]
          }
        },
        {
          "id": "cooling-valve",
          "name": "Ventilation 2 cooling valve position",
          "unit": "unit:PERCENT",
          "deadband": 1,
          "objectType": "analog-output",
          "instance": 1,
          "semantics": {
            "brick": "Chilled_Water_Valve_Command",
            "haystack": ["cool", "valve", "cmd"]
          }
        },
        {
          "id": "fan-running",
          "name": "Ventilation 2 supply fan running",
          "objectType": "binary-input",
          "instance": 1,
          "semantics": {
            "brick": "Fan_Status",
            "haystack": ["discharge", "fan", "run", "sensor"]
          }
        }
      ]
    }
  ]
}
