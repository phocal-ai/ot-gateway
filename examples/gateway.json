{
  "site": "demo-site",
  "building": "building-a",
  "id": "main",
  "mqtt": {
    "url": "mqtt://localhost:1883",
    "clientId": "ot-gateway-demo"
  },
  "buffer": {
    "path": "./ot-gateway-buffer.sqlite"
  },
  "history": {
    "path": "./ot-gateway-history.sqlite"
  },
  "status": {},
  "devices": [
    {
      "protocol": "simulator",
      "id": "pv-inverter",
      "pollIntervalMs": 2000,
      "points": [
        {
          "id": "ac-power",
          "name": "PV inverter AC power",
          "unit": "unit:KiloW",
          "deadband": 0.1,
          "waveform": "sine",
          "min": 0,
          "max": 8,
          "periodSeconds": 60,
          "semantics": {
            "brick": "Active_Power_Sensor",
            "haystack": ["pv", "elec", "power", "active", "sensor"]
          }
        },
        {
          "id": "energy-today",
          "name": "PV inverter energy today",
          "unit": "unit:KiloW-HR",
          "waveform": "ramp",
          "min": 0,
          "max": 40,
          "periodSeconds": 120,
          "semantics": {
            "brick": "Energy_Sensor",
            "haystack": ["pv", "elec", "energy", "sensor"]
          }
        }
      ]
    },
    {
      "protocol": "modbus-tcp",
      "id": "energy-meter",
      "host": "127.0.0.1",
      "unitId": 1,
      "points": [
        {
          "id": "active-power",
          "name": "Energy meter active power",
          "unit": "unit:KiloW",
          "table": "holding",
          "address": 100,
          "dataType": "float32",
          "semantics": {
            "brick": "Active_Power_Sensor",
            "haystack": ["elec", "power", "active", "sensor"]
          }
        },
        {
          "id": "energy",
          "name": "Energy meter energy counter",
          "unit": "unit:KiloW-HR",
          "table": "input",
          "address": 0,
          "dataType": "uint32",
          "semantics": {
            "brick": "Energy_Sensor",
            "haystack": ["elec", "energy", "sensor"]
          }
        },
        {
          "id": "breaker-tripped",
          "name": "Main breaker tripped",
          "table": "discrete",
          "address": 0,
          "dataType": "bool",
          "semantics": {
            "brick": "Alarm",
            "haystack": ["elec", "breaker", "alarm"]
          }
        }
      ],
      "port": 5020
    },
    {
      "protocol": "bacnet-ip",
      "id": "heat-pump",
      "deviceInstance": 2001,
      "address": "127.0.0.1:47809",
      "pollIntervalMs": 5000,
      "points": [
        {
          "id": "flow-temp",
          "name": "Heat pump flow temperature",
          "unit": "unit:DEG_C",
          "deadband": 0.2,
          "objectType": "analog-input",
          "instance": 1,
          "semantics": {
            "brick": "Leaving_Hot_Water_Temperature_Sensor",
            "haystack": ["leaving", "hot", "water", "temp", "sensor"]
          }
        },
        {
          "id": "return-temp",
          "name": "Heat pump return temperature",
          "unit": "unit:DEG_C",
          "deadband": 0.2,
          "objectType": "analog-input",
          "instance": 2,
          "semantics": {
            "brick": "Entering_Hot_Water_Temperature_Sensor",
            "haystack": ["entering", "hot", "water", "temp", "sensor"]
          }
        },
        {
          "id": "compressor-running",
          "name": "Heat pump compressor running",
          "objectType": "binary-input",
          "instance": 1,
          "semantics": {
            "brick": "Run_Status",
            "haystack": ["compressor", "run", "sensor"]
          }
        }
      ]
    }
  ]
}
