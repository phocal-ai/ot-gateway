#!/bin/sh
# The ot-gateway command on a machine with Docker and no Node.js (a Raspberry Pi): it runs the CLI from the
# gateway's image, with the current folder mounted as the working directory. Install it once, no sudo:
#
#   mkdir -p ~/.local/bin && curl -fsSL --retry 4 --retry-all-errors --retry-delay 2 https://raw.githubusercontent.com/phocal-ai/ot-gateway/main/packaging/ot-gateway -o ~/.local/bin/ot-gateway && chmod +x ~/.local/bin/ot-gateway && . ~/.profile
#
# The image tag follows the gateway: OT_GATEWAY_TAG when set, else the tag of the running `ot-gateway` container,
# else the default in the compose.yaml of the current folder or of ~/ot-gateway (OT_GATEWAY_HOME), else the
# release this file came with. So the command and the gateway are the same version, and upgrade together.
#
# A terminal gets -t (colors, prompts); a pipe or an agent does not, so `ot-gateway points template > points.csv`
# writes plain lines. Files outside the current folder are not visible to the command.
#
# The first run pulls the image (retried, its progress kept off stdout, which carries --json output); the moving tags
# dev and latest are checked for a newer image on every run. The long-running
# commands get a fixed container name, so `docker stop ot-gateway-demo` (-run, -watch, -simulate) stops one started in the
# background; only one of each runs at a time. The Compose service's container is `ot-gateway`.
set -eu

image=${OT_GATEWAY_IMAGE:-ghcr.io/phocal-ai/ot-gateway}
# Moved by each release with the other pins (CONTRIBUTING.md, "Branches").
release=v0.20.0

tag_of() {
  [ -f "$1" ] && sed -n 's/.*ot-gateway:\${OT_GATEWAY_TAG:-\([^}]*\)}.*/\1/p' "$1" | head -n 1
}

command -v docker >/dev/null 2>&1 || {
  echo "ot-gateway: docker is needed (docs/raspberry-pi-install.md, step 5)" >&2
  exit 127
}

tag=${OT_GATEWAY_TAG:-}
if [ -z "$tag" ]; then
  running=$(docker inspect --format '{{.Config.Image}}' ot-gateway 2>/dev/null) || running=
  case $running in "$image":*) tag=${running##*:} ;; esac
fi
[ -n "$tag" ] || tag=$(tag_of ./compose.yaml) || true
[ -n "$tag" ] || tag=$(tag_of "${OT_GATEWAY_HOME:-$HOME/ot-gateway}/compose.yaml") || true
[ -n "$tag" ] || tag=$release

# Docker that cannot be reached is not a missing image: say what to do instead of pulling 460 MB that is there.
docker_unreachable() {
  reason=$(printf '%s\n' "$1" | sed '/^[[:space:]]*$/d' | tail -n 1)
  case $reason in
    *"permission denied"*)
      echo "ot-gateway: Docker refused access to ${USER:-this user} (${reason})" >&2
      echo "  add yourself to the docker group: sudo usermod -aG docker \"\$USER\", then log out and in again (or run: newgrp docker)" >&2
      ;;
    *)
      echo "ot-gateway: Docker is not running (${reason})" >&2
      if [ "$(uname -s)" = Linux ]; then
        echo "  start it: sudo systemctl start docker (and at every boot: sudo systemctl enable docker)" >&2
      else
        echo "  start Docker Desktop, then run the command again" >&2
      fi
      ;;
  esac
  exit 1
}

# Only the two ways Docker cannot be reached stop here; anything else (no such image, in any engine's words) pulls.
present=
if err=$(docker image inspect "$image:$tag" 2>&1 >/dev/null); then
  present=1
else
  case $err in
    *"permission denied"* | *"Cannot connect to the Docker daemon"* | *"failed to connect to the docker API"* | *"Is the docker daemon running"*)
      docker_unreachable "$err"
      ;;
  esac
fi

# A moving tag (dev, the preview of the next release, or latest) is checked for a newer image on every run, once and
# without retries: offline, or with the registry down, the local image runs.
case $tag in dev | latest)
  if [ -n "$present" ]; then
    echo "ot-gateway: checking for a newer $image:$tag..." >&2
    if ! err=$(docker pull -q "$image:$tag" 2>&1 >/dev/null); then
      reason=$(printf '%s\n' "$err" | sed '/^[[:space:]]*$/d' | tail -n 1)
      echo "ot-gateway: could not check (${reason:-docker pull failed}), running the local image" >&2
    fi
  fi
  ;;
esac

# Pull before running, so a slow or flaky registry gets retries and one line each, not Docker's layer progress.
# A wrong tag or no access to Docker is not retried; giving up shows the last line of Docker's own error.
if [ -z "$present" ]; then
  echo "ot-gateway: pulling $image:$tag (about 460 MB)..." >&2
  attempt=1
  for backoff in 2 5 ""; do
    err=$(docker pull -q "$image:$tag" 2>&1 >/dev/null) && break
    reason=$(printf '%s\n' "$err" | sed '/^[[:space:]]*$/d' | tail -n 1)
    case $reason in
      *"manifest unknown"* | *"not found"* | *"permission denied"* | *"Cannot connect to the Docker daemon"* | *"failed to connect to the docker API"*) backoff= ;;
    esac
    if [ -z "$backoff" ]; then
      attempts="$attempt attempts"
      [ "$attempt" -eq 1 ] && attempts="1 attempt"
      echo "ot-gateway: could not pull $image:$tag after $attempts: ${reason:-docker pull failed}" >&2
      exit 1
    fi
    echo "ot-gateway: pull failed, retrying in $backoff s" >&2
    sleep "$backoff"
    attempt=$((attempt + 1))
  done
fi

# up, down, restart and upgrade drive Docker Compose for the folder: the CLI in the container gets this machine's
# docker command, its Compose plugin and its socket, and the folder at the same path as here, since Compose hands
# the daemon absolute paths (compose.yaml mounts its own folder). The docker command links only libc, which the
# image's Debian has; Compose is static. Docker Desktop's VM reaches no devices on the LAN, so not there.
deploy=
case ${1:-} in up | down | restart | upgrade)
  if [ "$(uname -s)" != Linux ]; then
    echo "ot-gateway: $1 runs the gateway under Docker on Linux; Docker Desktop cannot reach devices on the LAN" >&2
    echo "  run the gateway here with: ot-gateway run" >&2
    exit 1
  fi
  docker_bin=$(readlink -f "$(command -v docker)")
  compose_bin=
  for dir in "${DOCKER_CONFIG:-$HOME/.docker}/cli-plugins" /usr/local/lib/docker/cli-plugins \
    /usr/local/libexec/docker/cli-plugins /usr/lib/docker/cli-plugins /usr/libexec/docker/cli-plugins; do
    if [ -x "$dir/docker-compose" ]; then
      compose_bin=$(readlink -f "$dir/docker-compose")
      break
    fi
  done
  if [ -z "$compose_bin" ]; then
    echo "ot-gateway: $1 needs the Docker Compose plugin (docker compose); install it: sudo apt-get install -y docker-compose-plugin" >&2
    exit 1
  fi
  # Only this folder is mounted: a config or folder elsewhere is not visible to the command.
  for arg; do
    case $arg in /* | ../* | ..)
      echo "ot-gateway: $1 sees only the current folder; cd to the gateway's folder and run: ot-gateway $1" >&2
      exit 1
      ;;
    esac
  done
  socket=/var/run/docker.sock
  case ${DOCKER_HOST:-} in unix://*) socket=${DOCKER_HOST#unix://} ;; esac
  if [ ! -e "$socket" ]; then
    echo "ot-gateway: $1 needs Docker's socket, and $socket is not there: is Docker running? sudo systemctl enable --now docker" >&2
    exit 1
  fi
  deploy=1
  ;;
esac

# Long-running commands get a name to stop them by; the others may run side by side, unnamed.
name=
case ${1:-} in demo | run | watch | simulate) name=ot-gateway-$1 ;; esac
# `secret set` asks for a password without showing it, which takes a terminal on stdin whatever stdout is: without
# -t the container would read what is typed from a pipe, shown on the screen.
typed=
case "${1:-} ${2:-}" in "secret set") [ -t 0 ] && typed=1 ;; esac
if [ -n "$name" ]; then
  state=$(docker inspect --format '{{.State.Running}}' "$name" 2>/dev/null) || state=
  case $state in
    true)
      echo "ot-gateway: $name is already running; stop it with: docker stop $name" >&2
      exit 1
      ;;
    false) docker rm "$name" >/dev/null 2>&1 || true ;;
  esac
  set -- --name "$name" "$image:$tag" "$@"
else
  set -- "$image:$tag" "$@"
fi

# TZ: the host's time zone by name, so the CLI's clock times (text and --json `…Local`) are the site's, not UTC.
# Node carries its own zone data, so the name is enough. An explicit TZ wins.
if [ -z "${TZ:-}" ]; then
  TZ=$(cat /etc/timezone 2>/dev/null || true)
  [ -n "$TZ" ] || TZ=$(readlink /etc/localtime 2>/dev/null | sed -n 's|.*/zoneinfo/||p')
  [ -n "$TZ" ] && export TZ
fi

# SSH_CONNECTION and USER (passed only when set): over SSH, init's next steps name the tunnel to the status page.
# OT_GATEWAY_JSON and the variables coding agents set (passed only when set): --json on every command, and the hint
# that points an agent at it, as the CLI has them without Docker.
# OT_GATEWAY_DATA_DIR empty: relative paths in the config (the outbox, the history) resolve against the config's
# folder under /work, as the CLI does without Docker, not against the image's data volume, which --rm would discard.
if [ -n "$deploy" ]; then
  set -- -v "$docker_bin:/usr/local/bin/docker:ro" -v "$compose_bin:/usr/local/lib/docker/cli-plugins/docker-compose:ro" \
    -v "$socket:/var/run/docker.sock" --group-add "$(stat -L -c %g "$socket")" -e HOME=/tmp -e OT_GATEWAY_TAG \
    -v "$PWD:$PWD" -w "$PWD" "$@"
else
  set -- -v "$PWD:/work" -w /work "$@"
fi
if [ -t 0 ] && { [ -t 1 ] || [ -n "$typed" ]; }; then
  exec docker run --rm -i -t --network host --user "$(id -u):$(id -g)" -e SSH_CONNECTION -e USER -e TZ \
    -e OT_GATEWAY_JSON -e AI_AGENT -e CLAUDECODE -e CURSOR_AGENT -e GEMINI_CLI -e CODEX_SANDBOX -e OT_GATEWAY_DATA_DIR= "$@"
fi
exec docker run --rm -i --network host --user "$(id -u):$(id -g)" -e SSH_CONNECTION -e USER -e TZ \
  -e OT_GATEWAY_JSON -e AI_AGENT -e CLAUDECODE -e CURSOR_AGENT -e GEMINI_CLI -e CODEX_SANDBOX -e OT_GATEWAY_DATA_DIR= "$@"
