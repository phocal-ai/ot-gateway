#!/bin/sh
# The ot-gateway command on a machine with Docker and no Node.js (a Raspberry Pi): it runs the CLI from the
# gateway's image, with the current folder mounted as the working directory. Install it once, no sudo:
#
#   mkdir -p ~/.local/bin && curl -fsSL --retry 4 --retry-all-errors --retry-delay 2 https://raw.githubusercontent.com/phocal-ai/ot-gateway/main/packaging/ot-gateway -o ~/.local/bin/ot-gateway && chmod +x ~/.local/bin/ot-gateway && . ~/.profile
#
# The image tag follows the gateway: OT_GATEWAY_TAG when set, else the tag of the running `ot-gateway` container,
# else the default in the compose.yaml of the current folder or of ~/ot-gateway (OT_GATEWAY_HOME), else the
# release this file came with. So the command and the gateway are the same version, and upgrade together.
#
# A terminal gets -t (colors, prompts); a pipe or an agent does not, so `ot-gateway points template > points.csv`
# writes plain lines. Files outside the current folder are not visible to the command.
#
# The first run pulls the image (retried, its progress kept off stdout, which carries --json output); the moving tags
# dev and latest are checked for a newer image on every run. The long-running
# commands get a fixed container name, so `docker stop ot-gateway-demo` (-run, -watch) stops one started in the
# background; only one of each runs at a time. The Compose service's container is `ot-gateway`.
set -eu

image=${OT_GATEWAY_IMAGE:-ghcr.io/phocal-ai/ot-gateway}
# Moved by each release with the other pins (CONTRIBUTING.md, "Branches").
release=v0.12.0

tag_of() {
  [ -f "$1" ] && sed -n 's/.*ot-gateway:\${OT_GATEWAY_TAG:-\([^}]*\)}.*/\1/p' "$1" | head -n 1
}

command -v docker >/dev/null 2>&1 || {
  echo "ot-gateway: docker is needed (docs/raspberry-pi-install.md, step 5)" >&2
  exit 127
}

tag=${OT_GATEWAY_TAG:-}
if [ -z "$tag" ]; then
  running=$(docker inspect --format '{{.Config.Image}}' ot-gateway 2>/dev/null) || running=
  case $running in "$image":*) tag=${running##*:} ;; esac
fi
[ -n "$tag" ] || tag=$(tag_of ./compose.yaml) || true
[ -n "$tag" ] || tag=$(tag_of "${OT_GATEWAY_HOME:-$HOME/ot-gateway}/compose.yaml") || true
[ -n "$tag" ] || tag=$release

present=
docker image inspect "$image:$tag" >/dev/null 2>&1 && present=1

# A moving tag (dev, the preview of the next release, or latest) is checked for a newer image on every run, once and
# without retries: offline, or with the registry down, the local image runs.
case $tag in dev | latest)
  if [ -n "$present" ]; then
    echo "ot-gateway: checking for a newer $image:$tag..." >&2
    if ! err=$(docker pull -q "$image:$tag" 2>&1 >/dev/null); then
      reason=$(printf '%s\n' "$err" | sed '/^[[:space:]]*$/d' | tail -n 1)
      echo "ot-gateway: could not check (${reason:-docker pull failed}), running the local image" >&2
    fi
  fi
  ;;
esac

# Pull before running, so a slow or flaky registry gets retries and one line each, not Docker's layer progress.
# A wrong tag or no access to Docker is not retried; giving up shows the last line of Docker's own error.
if [ -z "$present" ]; then
  echo "ot-gateway: pulling $image:$tag (about 460 MB)..." >&2
  attempt=1
  for backoff in 2 5 ""; do
    err=$(docker pull -q "$image:$tag" 2>&1 >/dev/null) && break
    reason=$(printf '%s\n' "$err" | sed '/^[[:space:]]*$/d' | tail -n 1)
    case $reason in
      *"manifest unknown"* | *"not found"* | *"permission denied"* | *"Cannot connect to the Docker daemon"*) backoff= ;;
    esac
    if [ -z "$backoff" ]; then
      attempts="$attempt attempts"
      [ "$attempt" -eq 1 ] && attempts="1 attempt"
      echo "ot-gateway: could not pull $image:$tag after $attempts: ${reason:-docker pull failed}" >&2
      exit 1
    fi
    echo "ot-gateway: pull failed, retrying in $backoff s" >&2
    sleep "$backoff"
    attempt=$((attempt + 1))
  done
fi

# Long-running commands get a name to stop them by; the others may run side by side, unnamed.
name=
case ${1:-} in demo | run | watch) name=ot-gateway-$1 ;; esac
if [ -n "$name" ]; then
  state=$(docker inspect --format '{{.State.Running}}' "$name" 2>/dev/null) || state=
  case $state in
    true)
      echo "ot-gateway: $name is already running; stop it with: docker stop $name" >&2
      exit 1
      ;;
    false) docker rm "$name" >/dev/null 2>&1 || true ;;
  esac
  set -- --name "$name" "$image:$tag" "$@"
else
  set -- "$image:$tag" "$@"
fi

# SSH_CONNECTION and USER (passed only when set): over SSH, init's next steps name the tunnel to the status page.
if [ -t 0 ] && [ -t 1 ]; then
  exec docker run --rm -i -t --network host --user "$(id -u):$(id -g)" -e SSH_CONNECTION -e USER -v "$PWD:/work" -w /work "$@"
fi
exec docker run --rm -i --network host --user "$(id -u):$(id -g)" -e SSH_CONNECTION -e USER -v "$PWD:/work" -w /work "$@"
