# The OT Gateway as a systemd service (packaging/install.sh installs it).
#
# Config: /etc/ot-gateway/gateway.json, secrets and OTEL_* variables in
# /etc/ot-gateway/gateway.env. The outbox belongs under /var/lib/ot-gateway
# (StateDirectory), so point `buffer.path` there.
[Unit]
Description=OT Gateway building gateway (Modbus TCP and BACnet/IP to MQTT)
Documentation=https://github.com/phocal-ai/ot-gateway
Wants=network-online.target
After=network-online.target time-sync.target

[Service]
Type=simple
User=ot-gateway
Group=ot-gateway
WorkingDirectory=/opt/ot-gateway
EnvironmentFile=-/etc/ot-gateway/gateway.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/env node --max-semi-space-size=4 apps/gateway/src/main.ts /etc/ot-gateway/gateway.json
# SIGINT is the gateway's clean shutdown: offline health message, cancelled COV subscriptions, outbox closed.
KillSignal=SIGINT
TimeoutStopSec=30
# A crash is a bug; the gateway itself rides out broker and device outages. Back off, never give up.
Restart=always
RestartSec=5
StartLimitIntervalSec=0

StateDirectory=ot-gateway
ReadOnlyPaths=/etc/ot-gateway
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
# Keep a runaway gateway from starving the rest of a small board.
MemoryMax=512M

[Install]
WantedBy=multi-user.target
