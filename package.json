{
  "name": "ot-gateway",
  "private": true,
  "description": "Effect-native edge gateway for buildings: Modbus TCP and BACnet/IP to MQTT.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "pnpm format:check && pnpm lint && turbo run typecheck test",
    "demo": "turbo run build --filter=@ot-gateway/web --output-logs=errors-only && node --max-semi-space-size=4 apps/gateway/src/main.ts demo",
    "ot-gateway": "node --max-semi-space-size=4 apps/gateway/src/main.ts",
    "gateway": "turbo run build --filter=@ot-gateway/web --output-logs=errors-only && pnpm --filter @ot-gateway/gateway start",
    "bench": "pnpm --filter @ot-gateway/gateway bench",
    "lint": "oxlint --type-aware --disable-nested-config --deny-warnings",
    "lint:fix": "oxlint --type-aware --disable-nested-config --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@effect/tsgo": "~0.63.0",
    "@effect/vitest": "4.1.2",
    "@types/node": "^22.20.5",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.28.0"
}
