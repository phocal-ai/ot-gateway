{
  "name": "plenum",
  "private": true,
  "description": "Effect-native edge gateway for buildings: Modbus TCP and BACnet/IP to MQTT.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "pnpm format:check && pnpm lint && turbo run typecheck test",
    "gateway": "pnpm --filter @plenum/gateway start",
    "bench": "pnpm --filter @plenum/gateway bench",
    "lint": "oxlint --type-aware --disable-nested-config --deny-warnings",
    "lint:fix": "oxlint --type-aware --disable-nested-config --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@effect/tsgo": "~0.63.0",
    "@effect/vitest": "4.1.2",
    "@types/node": "^22.18.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.28.0"
}
